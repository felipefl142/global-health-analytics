# Copie para .env e ajuste conforme necessario.

# --- Caminhos (opcionais; defaults em config/settings.py) ---
# DATA_DIR=./data
# MODELS_DIR=./models

# --- World Bank API ---
WB_API_BASE=https://api.worldbank.org/v2
WB_API_DELAY=0.6            # segundos entre chamadas (evitar rate limit)
WB_RETRIES=4

# --- Feast / Feature Store ---
FEAST_REGISTRY_PATH=./.feast/registry
FEAST_PROJECT=global_health
ONLINE_STORE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Drift monitoring ---
DRIFT_PSI_THRESHOLD=0.25
DRIFT_KS_THRESHOLD=0.30
